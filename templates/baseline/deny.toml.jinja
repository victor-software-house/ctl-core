[graph]
all-features = true

[advisories]
yanked = "deny"
unmaintained = "all"
# RUSTSEC ids and yanked crates that cannot be upgraded yet. Not a lint-level downgrade.
ignore = [
{%- for advisory in deny.ignore %}
    { id = "{{ advisory.id }}", reason = "{{ advisory.reason }}" },
{%- endfor %}
{%- if deny.ignore %}
{% endif -%}
]

[licenses]
allow = [
    "MIT",
    "Apache-2.0",
    "Apache-2.0 WITH LLVM-exception",
    "Unicode-3.0",
{%- for license in deny.licenses %}
    # {{ license.reason }}
    "{{ license.license }}",
{%- endfor %}
]
confidence-threshold = 0.93

[bans]
multiple-versions = "warn"
wildcards = "deny"
# Path dependencies carry no version; wildcards stay denied for the rest.
allow-wildcard-paths = true
highlight = "all"
deny = [
    { crate = "openssl", reason = "TLS is rustls" },
    { crate = "native-tls", reason = "TLS is rustls" },
{%- for ban in deny.bans %}
    { crate = "{{ ban.crate }}",{% if ban.wrappers %} wrappers = [{% for wrapper in ban.wrappers %}"{{ wrapper }}"{% if not loop.last %}, {% endif %}{% endfor %}],{% endif %} reason = "{{ ban.reason }}" },
{%- endfor %}
]
{%- if deny.skip %}
skip = [
{%- for skip in deny.skip %}
    { crate = "{{ skip.crate }}", reason = "{{ skip.reason }}" },
{%- endfor %}
]
{%- endif %}

# Declarations repeated outside [workspace.dependencies], and unused entries.
[bans.workspace-dependencies]
duplicates = "deny"
unused = "deny"

[sources]
unknown-registry = "deny"
unknown-git = "deny"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]
