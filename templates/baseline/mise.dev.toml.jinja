[tools]
"github:crate-ci/committed" = "1.1.11"
lefthook = "2.1.10"
rust = [
  # Pinned stable: build, lint, test.
  { version = "1.99.0", components = "clippy", mr_boxington = true },
  # Formatting only, for rustfmt's unstable options.
  { version = "nightly-2026-09-29", profile = "minimal", components = "rustfmt" },
]
mr-boxington = "1.20.0"
"github:EmbarkStudios/cargo-deny" = "0.20.2"
"github:bnjbvr/cargo-machete" = "0.9.2"
{%- if published %}
"github:obi1kenobi/cargo-semver-checks" = "0.51.0"
{%- endif %}
jq = "1.8.2"
