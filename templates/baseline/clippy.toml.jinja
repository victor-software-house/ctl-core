avoid-breaking-exported-api = false
allow-unwrap-in-tests = true
allow-expect-in-tests = true
disallowed-macros = [
    { path = "core::concat", reason = "use formatdoc/indoc for multiline strings" },
    { path = "std::concat", reason = "use formatdoc/indoc for multiline strings" },
]
{%- if tokio %}
await-holding-invalid-types = [
    "tokio::sync::MutexGuard",
    "tokio::sync::RwLockReadGuard",
    "tokio::sync::RwLockWriteGuard",
]
{%- endif %}
{%- if tokio or clippy.disallowed_methods %}
disallowed-methods = [
{%- if tokio %}
    { path = "tokio::sync::mpsc::unbounded_channel", reason = "no backpressure; use a bounded channel" },
{%- endif %}
{%- for entry in clippy.disallowed_methods %}
    { path = "{{ entry.path }}", reason = "{{ entry.reason }}" },
{%- endfor %}
]
{%- endif %}
{%- if clippy.disallowed_types %}
disallowed-types = [
{%- for entry in clippy.disallowed_types %}
    { path = "{{ entry.path }}", reason = "{{ entry.reason }}" },
{%- endfor %}
]
{%- endif %}
