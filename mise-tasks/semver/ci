#!/usr/bin/env bash
#MISE description="semver, allowing only the 0.6.15 baseline removal while 0.6.14 is the newest release"
# CI's Semver step. 0.6.15 removes the public `baseline` module and feature,
# which no consumer enables, and the operator ruled a patch release. While the
# newest ctl-core on crates.io is 0.6.14, a failing check passes only when every
# failed item belongs to that removal, so any other break still fails. Once
# 0.6.15 is published the full check runs; delete this task and call `semver`
# from CI then.
set -euo pipefail
newest=$(curl -fsS -A ctl-core-ci https://crates.io/api/v1/crates/ctl-core | jq -r .crate.max_stable_version)
if [ "$newest" != "0.6.14" ]; then
  exec cargo semver-checks
fi
if out=$(cargo semver-checks --color never 2>&1); then
  printf '%s\n' "$out"
  exit 0
fi
printf '%s\n' "$out"
items=$(printf '%s\n' "$out" | grep -E '^  [^ ]' || true)
other=$(printf '%s\n' "$items" | grep -v -e 'ctl_core::baseline' -e '/src/baseline\.rs:' -e 'feature baseline' || true)
if [ -z "$items" ] || [ -n "$other" ]; then
  echo "✘ semver failures beyond the 0.6.15 baseline removal:" >&2
  printf '%s\n' "${other:-no failed items found}" >&2
  exit 1
fi
echo "✔ only the 0.6.15 baseline removal fails, which this release allows"
