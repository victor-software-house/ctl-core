#!/usr/bin/env bash
#MISE description="tasks/rust.toml's check:versions runs verctl with a release config and passes without one"
# Runs the shared check:versions in a scratch repository whose `ver` task
# prints a marker instead of running verctl.
set -euo pipefail

scratch="$(mktemp -d)"
trap 'rm -rf "${scratch}"' EXIT
cp tasks/rust.toml "${scratch}/rust.toml"
cat > "${scratch}/mise.toml" <<'EOF'
[task_config]
includes = ["rust.toml"]

[tasks.ver]
run = "echo verctl-stub-ran"
EOF
export MISE_TRUSTED_CONFIG_PATHS="${scratch}"

# Prints the task's output, and fails when the task fails. Each call is
# assigned before it is passed on: set -e stops at a failing assignment, not
# at a failing substitution inside another command's arguments.
versions() {
  mise -C "${scratch}" run check:versions 2>&1
}

# $1 names the case, $2 is the output, $3 is the line it must hold, and $4,
# when given, a line it must not.
expect() {
  if ! grep -qF -- "$3" <<<"$2"; then
    printf '✘ %s: missing %s in:\n%s\n' "$1" "$3" "$2"
    exit 1
  fi
  if [ -n "${4:-}" ] && grep -qF -- "$4" <<<"$2"; then
    printf '✘ %s: unexpected %s in:\n%s\n' "$1" "$4" "$2"
    exit 1
  fi
  printf '✔ %s\n' "$1"
}

out="$(versions)"
expect "no .ctl/ver.yaml: passes without verctl" "${out}" \
  "no .ctl/ver.yaml: this repository declares no releases, nothing to compare" \
  verctl-stub-ran

mkdir "${scratch}/.ctl"
touch "${scratch}/.ctl/ver.yaml"
out="$(versions)"
expect ".ctl/ver.yaml: runs verctl" "${out}" verctl-stub-ran

out="$(VERCTL_CONFIG=release/ver.yaml versions)"
expect "VERCTL_CONFIG names a missing file: passes without verctl" "${out}" \
  "no release/ver.yaml: this repository declares no releases" \
  verctl-stub-ran
