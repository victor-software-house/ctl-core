---
source: ctl-core/tests/usage_spec.rs
expression: visible(&mounted_toy())
---
name toy
bin toy
version "1.0.0"
about "A toy CLI"
unknown_flags error
arg_required_else_help #true
args_override_self #false
subcommand_required #true
usage "Usage: toy [OPTIONS] <COMMAND>"
flag "-f --format" help="Output representation" global=#true help_heading=Output default=pretty {
    arg <FORMAT> {
        choices {
            choice pretty help="Human text, optionally coloured"
            choice json help="Machine JSON. Never contains ANSI"
        }
    }
}
flag "-c --color" help="Pretty-output colour policy. JSON never contains ANSI" global=#true help_heading=Output default=auto {
    arg <COLOR> {
        choices {
            choice auto help="Colour when the stream is a terminal and the environment allows it"
            choice always help="Colour, whatever the environment holds"
            choice never help="No colour, whatever the environment holds"
        }
    }
}
flag --no-color help="Force colourless pretty output. Wins over `--color`" global=#true help_heading=Output
flag "-q --quiet" help="Suppress successful pretty output" global=#true help_heading=Output
cmd status display_order=4 args_override_self=#false help="Show the queue" unknown_flags=error
cmd check display_order=5 args_override_self=#false help="Check one file" unknown_flags=error {
    flag --strict help="Stop at the first problem"
    arg <PATH> help="The file to check"
    complete path type=path
}
